POSTGRES_USER=vib
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=vib_saas
DATABASE_URL=postgresql://vib:replace-with-a-long-random-password@postgres:5432/vib_saas?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
SEED_DEMO_DATA=false
BACKEND_PORT=3101
FRONTEND_PORT=8090
VITE_API_URL=http://localhost:3101
VITE_TICKETZ_URL=http://localhost:8085
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TICKETZ_BASE_URL=
TICKETZ_API_TOKEN=
TICKETZ_PROVISION_TOKEN=
TICKETZ_SSO_SECRET=change-me
TICKETZ_SSO_EMAIL_DOMAIN=correacloud.local
TICKETZ_SSO_USER_PROFILE=admin
NATIVE_WHATSAPP_AUTOSTART=true
WHATSAPP_LOG_LEVEL=warn
PUBLIC_API_URL=http://localhost:3101
N8N_WEBHOOK_URL=
N8N_WEBHOOK_BASE_URL=https://n8n.example.com
N8N_API_BASE_URL=https://n8n.example.com
N8N_API_KEY=
WEBHOOK_SECRET=change-me
PRINT_AGENT_TOKEN=change-me
PRINT_AGENT_API_URL=https://saas.correacloud.com.br/api
EFI_ENV=homologation
EFI_CLIENT_ID_HOMOLOG=
EFI_CLIENT_SECRET_HOMOLOG=
EFI_CERT_PATH_HOMOLOG=/app/secrets/efi/homolog/certificate.p12
EFI_CERT_PASSPHRASE_HOMOLOG=
EFI_PIX_KEY_HOMOLOG=
EFI_CLIENT_ID_PROD=
EFI_CLIENT_SECRET_PROD=
EFI_CERT_PATH_PROD=/app/secrets/efi/prod/certificate.p12
EFI_CERT_PASSPHRASE_PROD=
EFI_PIX_KEY_PROD=
EFI_PIX_EXPIRATION_SECONDS=86400
BILLING_AUTOMATION_ENABLED=true
BILLING_AUTOMATION_INTERVAL_MS=3600000
BILLING_GENERATE_DAYS_AHEAD=0
BILLING_GRACE_DAYS=3
BILLING_CONFIG_ENCRYPTION_KEY=change-me-long-random-key
EFI_SECRETS_DIR=/app/secrets/efi
